# ---------- DeepSeek (the brain) ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash = fast & cheap, deepseek-v4-pro = smarter
DEEPSEEK_MODEL=deepseek-flash

# ---------- Letta (long-term memory) ----------
# Leave LETTA_API_KEY empty to run without memory.
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com
# Optional: model / embedding handles for the memory agents (provider/model-name)
LETTA_AGENT_MODEL=
LETTA_EMBEDDING=
# Shared "brain" agent that stores search lessons learned from ALL users.
# Leave empty on first run – the app creates it and prints the id in the logs.
LETTA_GLOBAL_AGENT_ID=

# ---------- Browser ----------
# Option A (recommended for production): a hosted Chrome over CDP, e.g. Browserless
#   wss://production-sfo.browserless.io?token=YOUR_TOKEN
BROWSER_WS_ENDPOINT=
# Option B (local dev only): show the browser window so you can watch the agent
BROWSER_HEADFUL=true
# Option C (Vercel): leave BROWSER_WS_ENDPOINT empty -> uses @sparticuz/chromium automatically

# ---------- ACE self-learning playbook (shared, no personal data) ----------
ACE_ENABLED=true
# ACE_MODEL defaults to DEEPSEEK_MODEL
ACE_MODEL=
ACE_MAX_BULLETS=80
ACE_BULLETS_IN_PROMPT=15
# Storage (first that is set wins): Upstash Redis -> Letta global agent block "playbook"
# -> .data/ace-playbook.json (local dev only) -> in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Admin API: GET /api/playbook with header x-admin-token
ADMIN_TOKEN=
